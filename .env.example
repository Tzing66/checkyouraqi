# Copy to .env and fill in. Never commit .env.
OPENAQ_API_KEY=
FIRMS_MAP_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
LLM_PROVIDER=
LLM_API_KEY=
# Least-privilege profile for pipeline code; `checkyouraqi` (admin) is only for Terraform.
AWS_PROFILE=checkyouraqi-dev
AWS_REGION=ap-south-1
DATA_BUCKET=checkyouraqi-<account-id>
ATHENA_WORKGROUP=checkyouraqi
